  "cards": [
    {
      "dot": "cyan",
      "title": "重复的 PL 子流程",
      "items": [
        "每个 PL 层：量化 → 同步 X → RUN → 完成与排空 → 同步 Y → 反量化。",
        "Sparse24 每图重复 36 次；其余 PS 算子由模型顺序执行。"
      ]
    },
    {
      "dot": "emerald",
      "title": "验收与计时边界",
      "items": [
        "每图先生成并保存比对 / 排名结果，再执行 INFO；这些结果尚待批次提交。",
        "最终验收提交需要本批会话关闭、owner STOP 和设备关闭证明。"
      ]
    },
    {
      "dot": "amber",
      "title": "会话与异常",
      "items": [
        "同一会话可处理多图；每图 INFO 检查后可进入下一图，批次结束才关闭。",
        "最多 50 图 / 900 秒；执行未知时保留现场，不重放请求。"
      ]
    }
  ],
