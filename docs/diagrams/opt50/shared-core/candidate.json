  "cards": [
    {
      "dot": "cyan",
      "title": "同一套计算硬件",
      "items": [
        "mode 决定步数和取数，乘法与累加源位置仅一处。",
        "Dense / Sparse 是互斥权重格式；权重缓存和 32×16 阵列共用。"
      ]
    },
    {
      "dot": "emerald",
      "title": "2:4 的准确含义",
      "items": [
        "对每个输出列，在 K 方向每 4 个权重保留 2 个及其位置。",
        "Sparse 的 MAC 步数为 K/2；整网耗时还包含 PS、访存和校验，不能直接称整网快两倍。"
      ]
    },
    {
      "dot": "amber",
      "title": "流水范围",
      "items": [
        "权重装载和 metadata 验证先完成，随后进入计算 / 写回 DATAFLOW。",
        "这里是单层内部重叠；当前未实现跨视频帧流水。"
      ]
    }
  ]
