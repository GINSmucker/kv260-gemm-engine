{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:kv260:b:inference-result:v1",
  "title": "B complete DeiT inference result",
  "type": "object",
  "required": ["schema", "status", "run_id", "image_id", "backend", "execution_host", "architecture", "execution_kind", "model_linear_count", "PL_starts", "fallback_count", "logits", "top5", "graph_sha256", "quant_protocol_sha256", "inference_ms"],
  "properties": {
    "schema": {"const": "b_inference_result_v1"},
    "status": {"const": "PASS"},
    "run_id": {"type": "string", "pattern": "^[A-Za-z0-9_-]{1,80}$"},
    "image_id": {"type": "string", "pattern": "^[A-Za-z0-9_-]{1,80}$"},
    "execution_kind": {"enum": ["CPU_FP32", "CPU_REFERENCE", "FPGA_MODEL"]},
    "model_linear_count": {"const": 49},
    "PL_starts": {"enum": [0, 49]},
    "fallback_count": {"const": 0},
    "logits": {"type": "array", "minItems": 1000, "maxItems": 1000, "items": {"type": "number"}},
    "top5": {
      "type": "array", "minItems": 5, "maxItems": 5,
      "items": {
        "type": "object", "required": ["index", "wnid", "name", "logit", "probability"],
        "properties": {
          "index": {"type": "integer", "minimum": 0, "maximum": 999},
          "wnid": {"type": "string"}, "name": {"type": "string"},
          "logit": {"type": "number"}, "probability": {"type": "number", "minimum": 0, "maximum": 1}
        }
      }
    },
    "graph_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "quant_protocol_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "inference_ms": {"type": "number", "minimum": 0},
    "actual_owner_identity": {"type": ["object", "null"]},
    "layer_trace": {"type": ["string", "null"]}
  },
  "allOf": [{
    "if": {"properties": {"execution_kind": {"const": "FPGA_MODEL"}}},
    "then": {
      "required": ["observed_custom_calls", "actual_owner_identity", "layer_trace"],
      "properties": {"PL_starts": {"const": 49}, "observed_custom_calls": {"const": 49},
        "actual_owner_identity": {"type": "object"}, "layer_trace": {"type": "string"}}
    },
    "else": {"properties": {"PL_starts": {"const": 0}, "actual_owner_identity": {"type": "null"}}}
  }],
  "additionalProperties": true
}
