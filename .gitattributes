* text=auto
/.gitattributes text eol=lf
/.gitignore text eol=lf

*.c text eol=lf
*.cpp text eol=lf
*.h text eol=lf
*.hpp text eol=lf
*.py text eol=lf
*.tcl text eol=lf
*.xdc text eol=lf
*.cfg text eol=lf
# Historical Markdown files include both CRLF and LF; preserve their bytes.
*.md -text
*.json text eol=lf
*.csv text eol=lf

# Frozen version sources retain their original bytes and embedded SHA256 pins.
hls/versions/** -text whitespace=-blank-at-eol,-blank-at-eof
board/versions/** -text whitespace=-blank-at-eol,-blank-at-eof
model/versions/** -text whitespace=-blank-at-eol,-blank-at-eof
docs/versions/** -text
results/versions/** -text

# Active v3 copies preserve the same byte-pinned source and runtime payloads.
hls/** -text whitespace=-blank-at-eol,-blank-at-eof
board/** -text whitespace=-blank-at-eol,-blank-at-eof
model/** -text whitespace=-blank-at-eol,-blank-at-eof
docs/provenance/** -text whitespace=-blank-at-eol,-blank-at-eof

# Preserve active branch source and copied provenance bytes.
hls/** -text whitespace=-blank-at-eol,-blank-at-eof
board/** -text whitespace=-blank-at-eol,-blank-at-eof
model/** -text whitespace=-blank-at-eol,-blank-at-eof
docs/provenance/** -text whitespace=-blank-at-eol,-blank-at-eof
